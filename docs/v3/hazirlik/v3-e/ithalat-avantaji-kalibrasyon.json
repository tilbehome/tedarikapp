{
  "dosya_ozeti_5_satir": [
    "Ne işe yarar: Yurtiçi NET alış ile ithalat NET landed costunu karşılaştırır; fark, başabaş, senaryo ve toplam yükü kalibre eder.",
    "Hangi fazda: V3-E Yurtiçi Fiyat Defteri, İthalat Avantajı ve karar günlüğü motorunda kullanılır.",
    "Temel ilke: NET esastır; DDP brüt varsayılan %20 ile ayrılır, ürün bazlı açık oran varsayılanı ezer ve 16C tanımı değişmez.",
    "Çıktı: Matematik sözleşmesi, karar snapshot’ı ve İA-001..İA-016 kuruş kesinliğinde kalibrasyon vakalarıdır.",
    "Kapsam dışı: GTİP, mevzuat, gümrük vergisi oranı veya hukuki/vergi niteliğinde yorum üretmek kalıcı RET’tir."
  ],
  "schema_version": "1.0",
  "yurtici_fiyat_defteri_sozlesmesi": {
    "required_fields": [
      "price_record_id",
      "product_match_id",
      "variant_match_id",
      "supplier_name",
      "observed_at",
      "currency",
      "price_basis",
      "unit",
      "pack_qty",
      "evidence_ref"
    ],
    "money_fields": [
      "gross_unit_price",
      "vat_rate_pct",
      "net_unit_price",
      "shipping_net_unit"
    ],
    "formula": "net_unit_price = gross_unit_price / (1 + vat_rate_pct/100); açık net fiyat varsa gross ayrıştırması yapılmaz.",
    "comparability_gate": "Aynı ürün/varyant, aynı satış birimi, karşılaştırılabilir paket miktarı ve geçerli tarih olmadan fiyat avantaj hesabına girmez.",
    "history_rule": "Eski kayıt üzerine yazılmaz; yeni tarihli immutable snapshot eklenir."
  },
  "net_basis_contract": {
    "system_basis": "NET",
    "ddp_default_vat_rate_pct": "20",
    "formula": "ddp_net = ddp_gross / (1 + vat_rate/100)",
    "override": "Ürün bazında açık vat_rate_pct varsayılan %20’yi ezer.",
    "landed_cost_reference": "Görev #16C landed-cost-kalibrasyon.json ACTUAL/OFFER_DDP tanımı",
    "rounding": "Para sonuçları HALF_UP 0.01; ara işlemler yüksek hassasiyette."
  },
  "comparison_formulas": {
    "advantage_tl_unit": "domestic_net_unit - import_net_unit",
    "advantage_pct": "advantage_tl_unit / domestic_net_unit * 100",
    "total_advantage_tl": "advantage_tl_unit * effective_qty"
  },
  "effective_quantity_contract": {
    "carton_count": "ceil(requested_qty / units_per_carton)",
    "effective_qty": "carton_count * units_per_carton",
    "reference": "Görev #16D cbm-matematik.json",
    "moq_gate": "effective_qty >= moq; değilse yazılı istisna olmadan sert engel."
  },
  "landed_curve": {
    "tier_selection": "effective_qty değerini kapsayan en yüksek min_qty kademesi; max_qty varsa sınır dahil kontrol edilir.",
    "product_tl_unit": "tier_foreign_unit_price * locked_fx",
    "fixed_expense_unit": "fixed_expense_net_total / effective_qty",
    "import_net_unit": "product_tl_unit + variable_expense_net_unit + fixed_expense_unit",
    "break_even": "MOQ’yu karşılayan ilk koli katından başlayarak artan etkin adetlerde import_net_unit <= domestic_net_unit koşulunu sağlayan en küçük adet.",
    "boundary_rule": "Kademe eşikleri koli katına yukarı yuvarlanır; aday adet hem kademe hem koli hem MOQ bekçilerini sağlamalıdır."
  },
  "total_load_components": {
    "wait_time": {
      "value": "wait_days",
      "cost": "bound_cash_tl * annual_financing_rate_pct/100 * wait_days/365",
      "missing": "Girdi yoksa veri yok; 0 yazılmaz."
    },
    "moq": {
      "excess_qty": "max(0, effective_qty - planned_demand_qty)",
      "excess_cash": "excess_qty * import_net_unit"
    },
    "bound_cash": {
      "formula": "import_net_unit * effective_qty",
      "note": "Ödeme takviminde yalnız bağlanan bölüm biliniyorsa o bölüm ayrıca gösterilir; bilinmiyorsa tüm landed toplam üst sınırdır."
    },
    "fx_risk": {
      "formula": "Aynı kur duyarlı ürün ve masraf satırlarını senaryo kuruyla yeniden çevir; TL sabit masrafları değiştirme.",
      "missing": "Kur aralığı/senaryosu yoksa veri yok."
    }
  },
  "scenario_math": "Kur, navlun/sabit masraf veya istenen adet değiştiğinde kademe seçimi, koliye yuvarlama, sabit masraf/adet, landed unit, fark ve uyarı baştan hesaplanır; eski snapshot değişmez.",
  "warning_thresholds": {
    "AVANTAJ_KALMADI": "advantage_tl_unit <= 0.00 veya seçili risk senaryosunda <= 0.00",
    "AVANTAJ_ZAYIF": "0.00 < advantage_pct < configurable_min_advantage_pct; varsayılan kalibrasyon %5",
    "ADVANTAGE": "advantage_pct >= configurable_min_advantage_pct"
  },
  "decision_log_contract": {
    "required_fields": [
      "decision_id",
      "product_match_id",
      "decision",
      "reason",
      "decided_at",
      "decided_by",
      "domestic_price_snapshot",
      "import_cost_snapshot",
      "fx_snapshot",
      "quantity_snapshot",
      "scenario_snapshot",
      "advantage_tl_unit",
      "advantage_pct",
      "warning_state"
    ],
    "immutable": true,
    "decisions": [
      "IMPORT",
      "BUY_DOMESTIC",
      "WAIT",
      "REJECT_DATA"
    ]
  },
