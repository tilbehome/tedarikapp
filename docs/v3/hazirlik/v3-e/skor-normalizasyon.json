{
  "dosya_ozeti_5_satir": [
    "Ne işe yarar: Platform içi ürün sinyallerini yüzdeliğe çevirir, GİZLİ koşulunu ve sert engel önceliğini sınar.",
    "Hangi fazda: V3-E skor motoru, karar kartı ve platform adaptörü kabul testlerinde kullanılır.",
    "Temel ilke: Skor yalnız platform × kategori içinde sıralar; platformlar arası puan kıyası yasaktır.",
    "Çıktı: Altı sinyal, on bir sert engel, altı karar boyutu ve SN-001..SN-016 altın test vektörüdür.",
    "Kapsam dışı: Sipariş yetkisi verme, mevzuat/GTİP/vergi hesabı ve eksik veriden yapay skor üretmedir."
  ],
  "schema_version": "1.0",
  "comparison_boundary": {
    "cross_platform_score_comparison": "FORBIDDEN",
    "rule": "Normalize skor yalnız aynı platform × kategori evrenindeki sıralamadır; çapraz platform kararı altı boyutlu karar kartıyla verilir."
  },
  "percentile_rule": {
    "primary_universe": "platform × leaf_category",
    "minimum_n": 20,
    "fallback_universe": "platform × parent_category",
    "fallback_minimum_n": 50,
    "no_global_cross_category_fallback": true,
    "higher_better": "(count(x_i < x) + 0.5 * count(x_i = x)) / N * 100",
    "lower_better": "(count(x_i > x) + 0.5 * count(x_i = x)) / N * 100",
    "rounding": "HALF_UP 0.01",
    "insufficient_sample": "Sinyal INSUFFICIENT_SAMPLE olur ve bileşik paydasından çıkar; zorunlu grup boş kalırsa skor GİZLİ."
  },
  "visibility_rule": {
    "required_groups": [
      "PRODUCT_METRICS",
      "SUPPLIER_SCORECARD"
    ],
    "rule": "Her iki grupta en az bir uygun, yeterli örnekli sinyal yoksa sayı, yüzde, yıldız, renkli bant ve sıralama üretilmez.",
    "display": "Skor için veri yetersiz",
    "inherited_from": "Görev #8 / C3 / skor-kalibrasyon-seti.json"
  },
  "signals": [
    {
      "id": "sales_30d",
      "group": "PRODUCT_METRICS",
      "weight": 30,
      "direction": "HIGHER_BETTER"
    },
    {
      "id": "sales_total",
      "group": "PRODUCT_METRICS",
      "weight": 10,
      "direction": "HIGHER_BETTER"
    },
    {
      "id": "rating",
      "group": "PRODUCT_METRICS",
      "weight": 20,
      "direction": "HIGHER_BETTER"
    },
    {
      "id": "review_count",
      "group": "PRODUCT_METRICS",
      "weight": 10,
      "direction": "HIGHER_BETTER"
    },
    {
      "id": "seller_quality",
      "group": "SUPPLIER_SCORECARD",
      "weight": 20,
      "direction": "HIGHER_BETTER"
    },
    {
      "id": "seller_response_hours",
      "group": "SUPPLIER_SCORECARD",
      "weight": 10,
      "direction": "LOWER_BETTER"
    }
  ],
  "composite_rule": {
    "formula": "sum(percentile_i * active_weight_i) / sum(active_weight_i)",
    "missing_yok": "Ağırlık paydadan çıkar; 0 yazılmaz.",
    "rounding": "HALF_UP 0.01",
    "bands": {
      "yuksek": "score >= 75.00",
      "orta": "45.00 <= score < 75.00",
      "dusuk": "score < 45.00",
      "gizli": "visibility=HIDDEN"
    }
  },
  "hard_blockers": [
    {
      "id": "HB-001",
      "code": "UNSUPPORTED_SOURCE_ROLE",
