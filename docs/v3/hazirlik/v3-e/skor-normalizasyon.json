      "priority": "BEFORE_SCORE"
    },
    {
      "id": "HB-007",
      "code": "REQUIRED_EVIDENCE_MISSING",
      "rule": "Ürün sahibi tarafından bu kategori için zorunlu işaretlenen uygunluk/kanıt belgesi yok; sistem mevzuat çıkarımı yapmaz.",
      "priority": "BEFORE_SCORE"
    },
    {
      "id": "HB-008",
      "code": "SUPPLIER_PAYMENT_IDENTITY_MISMATCH",
      "rule": "Teklif tedarikçisi, ödeme alıcısı veya doğrulanmış firma kimliği uyuşmuyor.",
      "priority": "BEFORE_SCORE"
    },
    {
      "id": "HB-009",
      "code": "EXTREME_PRICE_ANOMALY_UNRESOLVED",
      "rule": "Geçmiş snapshot veya platform içi dağılıma göre aşırı fiyat sapması açıklanmamış.",
      "priority": "BEFORE_SCORE"
    },
    {
      "id": "HB-010",
      "code": "DUPLICATE_ACTIVE_ALLOCATION",
      "rule": "Aynı kaynak ürün+SKU+teklif bağı etkin siparişte ikinci kez tahsis edilmiş.",
      "priority": "BEFORE_SCORE"
    },
    {
      "id": "HB-011",
      "code": "IMPORT_COST_INPUT_INVALID",
      "rule": "NET/BRÜT, KDV oranı, kur snapshot’ı veya landed-cost birimi çelişkili ve düzeltilememiş.",
      "priority": "BEFORE_SCORE"
    }
  ],
