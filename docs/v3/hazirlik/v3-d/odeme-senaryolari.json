          "kur_politikasi": "payment_day|locked"
        }
      ]
    },
    {
      "plan_id": "PAY-PLAN-02",
      "ad": "Kapora + bakiye",
      "parametreler": [
        "deposit_pct",
        "balance_pct",
        "balance_release_event"
      ],
      "bekci": "deposit_pct + balance_pct = 100",
      "satirlar": [
        {
          "satir_no": 1,
          "tutar_formulu": "siparis_net_toplam * deposit_pct / 100",
          "vade_olayi": "ORDER_APPROVED",
          "dekont_eki_zorunlu": true,
          "kur_politikasi": "payment_day|locked"
        },
        {
          "satir_no": 2,
          "tutar_formulu": "siparis_net_toplam * balance_pct / 100",
          "vade_olayi": "balance_release_event: BEFORE_LOADING|ETA|GOODS_ACCEPTED",
