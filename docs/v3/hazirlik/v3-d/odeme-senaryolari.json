{
  "dosya_ozeti_5_satir": [
    "Ne işe yarar: Sipariş ödemelerini plan, vade olayı, kanıt ve kur kaydı halinde kalıcılaştırır.",
    "Hangi fazda: V3-D ödeme/kanıt uygulaması ve İE#24 altın testlerinde kullanılır.",
    "Temel ilke: Ödeme, kanıt ve kur farkı ayrı değişmez kayıt satırlarıdır.",
    "Çıktı: Dört plan şablonu, kilometre taşı eşleşmeleri ve ODM-001..ODM-012 beklenen kayıtlarıdır.",
    "Kapsam dışı: Banka entegrasyonu, vergi/mevzuat ve gümrük vergisi hesabıdır."
  ],
  "schema_version": "1.0",
  "para_kurallari": {
    "tutar_tipi": "Ondalık tutarlar JSON number değil string olarak saklanır.",
    "kur_kaydi": "original_currency, original_amount, rate_snapshot_id, rate, rate_date ve converted_amount birlikte tutulur.",
    "odeme_gunu_kuru": "Fiilî ödeme günündeki doğrulanmış kur snapshot'ı kullanılır.",
    "kilitli_kur": "Sözleşme/karar snapshot'ındaki kur değişmez; ödeme günü kuru fark yaratırsa ana borç satırı değiştirilmez.",
    "kur_farki": "Lehte veya aleyhte fark FX_DIFFERENCE türünde ayrı satırdır; yön tedarikçi borcunu taşıyan alıcı açısından yazılır.",
    "dekont": "PAYMENT kaydının doğrulanmış olması için en az bir dekont eki veya banka işlem referansı zorunludur."
  },
  "plan_sablonlari": [
