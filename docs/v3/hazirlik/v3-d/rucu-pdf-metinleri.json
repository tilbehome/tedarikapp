      "product_code",
      "product_name",
      "expected_variant",
      "received_variant",
      "expected_quantity",
      "received_quantity",
      "accepted_quantity",
      "missing_quantity",
      "damaged_quantity",
      "wrong_variant_quantity",
      "discrepancy_types",
      "discrepancy_description",
      "package_condition",
      "photo_refs",
      "line_note"
    ],
    "rucu": [
