      "claim_amount",
      "requested_remedy",
      "response_due_business_days",
      "supplier_response",
      "resolution_status"
    ],
    "imza": [
      "prepared_by_name_title",
      "prepared_by_signature",
      "received_by_name_title",
      "received_by_signature",
      "supplier_representative_name_title",
      "supplier_representative_signature",
      "signature_date"
    ]
  },
  "dogrulama_kurallari": [
    "expected_quantity, received_quantity ve accepted_quantity negatif olamaz.",
    "missing_quantity = max(expected_quantity - received_quantity, 0).",
    "accepted_quantity + damaged_quantity + wrong_variant_quantity, received_quantity değerini aşamaz; aynı fiziksel adet iki uygunsuzlukta sayılıyorsa overlap işareti zorunludur.",
    "Her eksik/hasar/yanlış varyant satırı en az bir açıklama ve mümkünse photo_ref taşır; kanıt yoksa reason_no_photo zorunludur.",
    "party_id ve bill_of_lading_no belge snapshot'ına bağlıdır; metin olarak sessizce değiştirilemez.",
    "İmzadan sonra satırlar salt okunur; düzeltme yeni revision üretir."
  ],
  "pdf_bolum_sirasi": [
    "document_header",
