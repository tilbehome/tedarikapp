{
  "dosya_ozeti_5_satir": [
    "Ne işe yarar: Gerçekleşen ürün maliyetine masrafların değer, ağırlık veya CBM ile dağıtımını kalibre eder.",
    "Hangi fazda: V3-D landed-cost motoru ve İE#24 kabul kapısında kullanılır.",
    "Temel ilke: Kaynak, teklif DDP ve gerçekleşen görünüm birbirine yazılmaz; sistem içi tutarlar nettir.",
    "Çıktı: Masraf kataloğu, kuruş kapatan dağıtım kuralları ve LC-001..LC-016 altın vakalarıdır.",
    "Kapsam dışı: GTİP, mevzuat, gümrük vergisi ve herhangi bir vergi oranının hukuki tespitidir."
  ],
  "schema_version": "1.0",
  "kabul_kapisi": "Uygulama LC-001..LC-016 setinin %100'ünü kuruş farksız geçmeli; beklenen REJECTED vakayı hesaplamaya zorlamamalıdır.",
  "net_kurali": {
    "system_basis": "NET",
    "ddp_default_vat_rate_pct": "20",
    "formula": "net = ddp_gross / (1 + vat_rate/100); vat = ddp_gross - net",
    "warning": "%20 yalnız bu kalibrasyon setinin varsayılanıdır; mevzuat/vergi tespiti değildir. Ürün bazında açık oran varsa o kullanılır."
  },
  "masraf_katalogu": [
    {
      "type": "FREIGHT",
      "tr": "Navlun"
    },
    {
      "type": "CUSTOMS_SERVICE",
      "tr": "Gümrük hizmet bedeli",
      "note": "Vergi/oran hesabı içermez."
    },
    {
      "type": "INLAND_TRANSPORT",
      "tr": "İç nakliye"
    },
    {
      "type": "BANK",
      "tr": "Banka masrafı"
    },
    {
      "type": "INSURANCE",
      "tr": "Sigorta"
    },
    {
      "type": "OTHER",
      "tr": "Diğer",
      "requires": "free_label"
    }
  ],
  "dagitim_anahtarlari": [
    {
      "key": "VALUE",
      "formula": "masraf * ürün_net_değeri / toplam_net_değer"
    },
    {
      "key": "WEIGHT",
      "formula": "masraf * ürün_toplam_brüt_ağırlığı / toplam_brüt_ağırlık"
    },
    {
      "key": "CBM",
      "formula": "masraf * ürün_toplam_cbm / toplam_cbm"
    }
  ],
  "yuvarlama": {
    "expense_conversion": "Her masraf kendi kilitli kuruyla hesap para birimine çevrilir ve HALF_UP ile 0.01'e yuvarlanır.",
    "allocation": "Ham paylar yüksek hassasiyetle hesaplanır; önce 0.01'e aşağı kesilir, kalan kuruş en büyük ondalık kalandan başlayarak dağıtılır.",
    "tie_break": "Ondalık kalan eşitse product_id artan sıra.",
    "control": "Her masrafta dağıtılan satırların toplamı çevrilmiş masrafla birebir eşit olmalıdır.",
    "unit_cost": "Gerçek birim maliyet HALF_UP ile 0.01'e yuvarlanır."
  },
  "gorunumler": {
    "SOURCE_SHOWCASE": {
      "fields": [
        "source_currency",
        "source_unit_price",
        "source_price_observed_at"
      ],
      "rule": "İlandan gelir; teklif veya gerçekleşen alanın üzerine yazmaz."
    },
    "OFFER_DDP": {
      "fields": [
        "supplier_round_id",
        "ddp_gross_unit_price",
        "vat_rate",
        "offer_currency",
        "valid_until"
      ],
      "rule": "Firma teklif snapshot'ından gelir; net ayrıştırma oranıyla birlikte sürümlenir."
    },
    "ACTUAL": {
      "fields": [
        "accepted_quantity",
        "actual_product_net_total",
        "actual_expenses",
        "actual_landed_total",
        "actual_unit_cost"
      ],
      "rule": "Kanıtlı gerçek ödeme/masraf ve mal kabulden gelir; eksik teslimde kabul adedi birim maliyet paydasıdır."
    }
  },
