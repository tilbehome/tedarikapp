{
  "dosya_ozeti_5_satir": [
    "Ne işe yarar: Koli ölçüsü, miktar, CBM, brüt ağırlık ve konteyner doluluğunu aynı matematikte birleştirir.",
    "Hangi fazda: V3-D konteyner/LCL planlama motoru ve İE#24 testlerinde kullanılır.",
    "Temel ilke: Doluluk hacim ve ağırlıktan büyük olan oranla belirlenir; koli sayısı daima yukarı yuvarlanır.",
    "Çıktı: Konteyner referansları, yer-kaldı önerisi ve CBM-001..CBM-014 test vektörleridir.",
    "Kapsam dışı: Rota/taşıyıcı rezervasyonu, tehlikeli yük kararı, mevzuat ve gümrük vergisi hesabıdır."
  ],
  "schema_version": "1.0",
  "formuller": {
    "carton_cbm": "length_cm * width_cm * height_cm / 1,000,000",
    "carton_count": "ceil(requested_qty / units_per_carton)",
    "effective_order_qty": "carton_count * units_per_carton",
    "total_cbm": "carton_count * carton_cbm",
    "total_gross_weight_kg": "carton_count * gross_kg_per_carton",
    "volume_pct": "total_cbm / planning_usable_cbm * 100",
    "weight_pct": "total_gross_weight_kg / planning_weight_limit_kg * 100",
    "overall_pct": "max(volume_pct, weight_pct)",
    "candidate_cartons": "min(floor(remaining_cbm/candidate_carton_cbm), floor(remaining_weight/candidate_gross_kg_per_carton))",
    "candidate_qty": "candidate_cartons * candidate_units_per_carton"
  },
