{
    "name": "tilbehome/tedarikapp",
    "description": "1688.com tedarik listesi yönetim sistemi — panel + Chrome eklentisi + Excel/PDF/paylaşım çıktıları",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.1",
        "monolog/monolog": "^3.7",
        "robthree/twofactorauth": "^3.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "ext-sodium": "TOTP secret şifrelemesinde tercih edilen arka uç (XSalsa20-Poly1305); yoksa OpenSSL AES-256-GCM kullanılır (K27/K39) — kurulum ZORUNLU KILMAZ"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
