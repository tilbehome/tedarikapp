{
  "name": "tedarikapp-panel",
  "private": true,
  "type": "module",
  "description": "tedarikapp yönetim paneli — React 19 + TypeScript + Vite (K5/K21)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/panel-damga.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview",
    "damga": "node scripts/panel-damga.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
