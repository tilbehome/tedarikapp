# Tüm istekleri front controller'a yönlendir (dosya/klasör olarak var olanlar hariç)
RewriteEngine On

# İE#10 5c: /media her koşulda STATİK kalır — dosya varsa Apache sunar, yoksa uygulamanın
# /media yedek ucu (404 yerine SPA yönlendirmesine düşmesin diye) devreye girer.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^media/ - [END]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
