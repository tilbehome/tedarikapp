# tedarikapp ortam konfigürasyonu — bu dosyayı .env olarak kopyalayıp doldurun.
# .env ASLA repoya girmez (.gitignore'da).

APP_ENV=production
APP_KEY=
APP_URL=https://tedarikapp.tilbehometoptan.com

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Eklenti API token'ı üretiminde kullanılan tuz (uzun rastgele dize)
EXTENSION_TOKEN_SALT=

TZ=Europe/Istanbul
