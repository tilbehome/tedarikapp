# ══════════════════════════════════════════════════════════════
#  tedarikapp — Ortam Konfigürasyonu Şablonu (.env.example)
# ══════════════════════════════════════════════════════════════
#  • Normal akışta bu dosyayı ELLE doldurmazsınız: kurulum sihirbazı
#    .env dosyasını kendisi üretir (docs/07 §3). Bu şablon, alanların
#    belgesi ve acil durum/manuel kurulum referansıdır.
#  • KURAL: .env ASLA repoya girmez (.gitignore'da). Sır yalnızca
#    .env'de yaşar — koda, loga, commit'e yazılmaz (CLAUDE.md §5).
#  • Boşluk içeren değerleri çift tırnakla yazın: DB_PASS="p@ss word"
# ══════════════════════════════════════════════════════════════

# ─────────────── Uygulama ───────────────
APP_NAME=tedarikapp
APP_ENV=production
# production | local — local yalnızca geliştirme makinesinde kullanılır
APP_DEBUG=false
# production'da DAİMA false: hata detayı kullanıcıya değil storage/logs'a gider
APP_URL=https://tedarikapp.tilbehometoptan.com
APP_KEY=
# 64 hex karakter uygulama anahtarı (oturum/çerez imzalama).
# Sihirbaz üretir; elle üretim: php -r "echo bin2hex(random_bytes(32));"
TZ=Europe/Istanbul
# Sunucu UTC'dir (docs/04 §7) — uygulama saatleri bu değere göre çalışır

# ─────────────── Veritabanı (MySQL) ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
# utf8mb4 ZORUNLU: Çince orijinal başlıklar (name_original) için — değiştirmeyin

# ─────────────── Oturum ve Giriş Güvenliği (K16) ───────────────
SESSION_NAME=tedarikapp_sid
SESSION_LIFETIME=120
# dakika — boşta kalma zaman aşımı; süre dolunca yeniden giriş + 2FA istenir
REMEMBER_ME_LIFETIME=43200
# dakika (30 gün) — "beni hatırla" ayrı ve iptal edilebilir token'ının ömrü
LOGIN_MAX_ATTEMPTS=5
# bu sayıda hatalı denemede IP geçici kilitlenir (denemeler activity_log'a yazılır)
LOGIN_LOCKOUT_MINUTES=15
# ilk kilit süresi; tekrarlarda artan bekleme (exponential backoff) uygulanır
TOTP_ISSUER=tedarikapp
# Google Authenticator/Authy'de hesabın görüneceği ad

# ─────────────── Eklenti API — /api/capture ───────────────
EXTENSION_TOKEN_SALT=
# Uzun rastgele dize (min 32 karakter) — eklenti Bearer token'ının üretim tuzu.
# Sihirbaz üretir. Token DB'de HASH'Lİ saklanır; tuz değişirse tüm token'lar geçersizleşir.
CAPTURE_MAX_PAYLOAD_KB=512
# Tek yakalama isteğinin üst boyutu (SKU matrisi + görsel listesi rahat sığar)
CAPTURE_RATE_PER_MIN=30
# Dakikada kabul edilen yakalama isteği — sızan token'la floodlamaya fren

# ─────────────── Medya — görsel indirme (K6) ───────────────
MEDIA_PATH=public/media
# Webden servis edilen TEK yazılabilir klasör (docs/07 §2) — değiştirmeyin
MEDIA_MAX_MB=8
# Tek görsel için üst indirme boyutu
MEDIA_DOWNLOAD_TIMEOUT=25
# saniye — 1688/alicdn yavaş yanıt verebilir (sunucu raporunda ~7,5 sn ölçüldü)
MEDIA_ALLOWED_HOSTS=alicdn.com,1688.com
# SSRF koruması: sunucu YALNIZCA bu alan adlarından görsel/video indirir

# ─────────────── Export ───────────────
# EXPORT_PATH kaldırıldı (K33/K37 §E11): üretim sunucusunda diske yazılamaz;
# export dosyaları diske değil, doğrudan yanıt akışına (stream) üretilir.
EXPORT_TTL_HOURS=24
# Geçici export kayıtlarının otomatik temizlenme süresi (export geçmişi kaydı DB'de kalır)

# ─────────────── Paylaşım Linki ───────────────
SHARE_TOKEN_LENGTH=26
# Kriptografik rastgele token uzunluğu — 22'nin altına DÜŞÜRMEYİN (K16)

# ─────────────── Günlükleme ───────────────
LOG_DRIVER=db
# db | file — üretimde DAİMA db (K33): sunucuda PHP `nobody` ile çalışır ve diske
# yazamaz; dosya hedefi orada sessizce kaybolur. Geliştirme makinesinde file kullanın.
LOG_PATH=storage/logs
# Yalnızca LOG_DRIVER=file iken kullanılır
LOG_LEVEL=warning
# debug | info | warning | error — production'da warning; sorun ayıklarken geçici info
LOG_RETENTION_DAYS=30
# Bu süreden eski kayıtlar housekeeping cron'unda temizlenir (bin/purge-trash.php):
# LOG_DRIVER=db iken app_logs tablosundan, file iken storage/logs dosyalarından

# ─────────────── Çöp Kutusu (K15) ───────────────
TRASH_RETENTION_DAYS=30
# Silinen liste/ürünlerin geri alınabilir kalma süresi; sonrasında kalıcı silinir
