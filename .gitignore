# Sırlar ve yerel konfigürasyon
.env
.env.*
!.env.example

# Bağımlılıklar
vendor/
node_modules/

# Çalışma zamanı verisi (görseller, loglar, önbellek)
# .htaccess REPO İLE GELİR (İE#9.3 f): storage webden kapalı kalmalı — savunma derinliği.
storage/*
!storage/.htaccess
*.log

# İndirilen ürün görselleri repoya girmez (klasör iskeleti ve koruma dosyası kalır).
# .htaccess REPO İLE GELMEK ZORUNDA: klasöre yazma izni verilmeden önce yerinde olmalı (K33/K34).
public/media/*
!public/media/.gitkeep
!public/media/.htaccess

# PM taslak klasörü (repoya girmez)
docs-taslak/

# Build çıktıları — panel derlemesi repoya GİRMEZ, sürüm zip'i içinde taşınır (İE#8 §5).
frontend/dist/
dist/
public/panel/

# Araç önbellekleri
.php-cs-fixer.cache
.phpunit.result.cache
.phpstan-cache/

# İşletim sistemi artıkları
Thumbs.db
Desktop.ini
.DS_Store

# Office kilit dosyaları (~$dosya.xlsx — dosya açıkken oluşur)
~$*

# Claude Code kişisel ayarları (paylaşılan ayar .claude/settings.json'dır)
.claude/settings.local.json

# IDE / editör
.idea/
.vscode/
*.swp
extension/node_modules/
extension/dist/
extension/.wxt/

# E2E (İE#13 Blok E) — Playwright çıktıları depoya girmez
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/

# Playwright çıktıları ve e2e köprü paketi (üretilmiş dosyalar)
e2e/dist/
e2e/test-results/
e2e/playwright-report/
frontend/test-results/

# D12: Ürün Sahibi'nin ham sayfa dökümleri docs/ altına düşerse repoya GİRMEZ.
# Fikstür olarak kullanılan sürümleri e2e/fixtures/1688/ altındadır; "Web Sayfası,
# Tamamı" kaydının `_files` klasörleri megabaytlarca üçüncü parti varlık taşır.
/docs/1688-*.html
/docs/1688-*_files/
