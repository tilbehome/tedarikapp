# Sırlar ve yerel konfigürasyon
.env
.env.*
!.env.example

# Bağımlılıklar
vendor/
node_modules/

# Çalışma zamanı verisi (görseller, loglar, önbellek)
storage/
*.log

# İndirilen ürün görselleri repoya girmez (klasör iskeleti ve koruma dosyası kalır).
# .htaccess REPO İLE GELMEK ZORUNDA: klasöre yazma izni verilmeden önce yerinde olmalı (K33/K34).
public/media/*
!public/media/.gitkeep
!public/media/.htaccess

# PM taslak klasörü (repoya girmez)
docs-taslak/

# Build çıktıları
frontend/dist/

# Araç önbellekleri
.php-cs-fixer.cache
.phpunit.result.cache
.phpstan-cache/

# İşletim sistemi artıkları
Thumbs.db
Desktop.ini
.DS_Store

# Office kilit dosyaları (~$dosya.xlsx — dosya açıkken oluşur)
~$*

# Claude Code kişisel ayarları (paylaşılan ayar .claude/settings.json'dır)
.claude/settings.local.json

# IDE / editör
.idea/
.vscode/
*.swp
